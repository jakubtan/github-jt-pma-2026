<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#ffffff">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Beer order"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvOrderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Which beer do you want to order?"
        android:textSize="20sp"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgBeers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbBeer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kozel 10"
            android:textStyle="bold"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbBeer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kozel 11"
            android:textStyle="bold"/>
    </RadioGroup>

    <RadioButton
        android:id="@+id/rbBottle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bottle"
        android:layout_marginLeft="16dp"
        android:checked="true"/>

    <RadioButton
        android:id="@+id/rbCan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can"
        android:layout_marginLeft="16dp"/>

    <RadioButton
        android:id="@+id/rbBarrel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barrel"
        android:layout_marginLeft="16dp"/>

    <Button
        android:id="@+id/btnOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_order_text"
        android:layout_marginLeft="16dp"/>

    <TextView
        android:id="@+id/tvOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/textview_order_summary_text"
        android:background="#f0f0f0"
        android:layout_marginTop="20dp"
        android:padding="16dp"/>
    
    <ImageView
        android:id="@+id/ivBeer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/koz_10_bottle"
        android:scaleType="centerInside"/>

</LinearLayout>