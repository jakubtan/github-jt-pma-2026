<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#ffffff">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Beer order"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvOrderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Which beer do you want to order?"
        android:textSize="20sp"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgBeers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbBeer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kozel 10"
            android:textStyle="bold"
            android:checked="true"
            android:padding="16dp"/>

        <RadioButton
            android:id="@+id/rbBeer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kozel 11"
            android:textStyle="bold"
            android:padding="16dp"/>

        <RadioButton
            android:id="@+id/rbBeer3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Braník 10"
            android:textStyle="bold"
            android:padding="16dp"/>
    </RadioGroup>

    <TextView
        android:id="@+id/tvAddOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add to your order: "
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/cbChips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chips"
        android:layout_marginLeft="16dp"/>

    <CheckBox
        android:id="@+id/cbPickledSausage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pickled sausage"
        android:layout_marginLeft="16dp"/>

    <CheckBox
        android:id="@+id/cbPickledCamembert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pickled Camembert"
        android:layout_marginLeft="16dp"/>

    <Button
        android:id="@+id/btnOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_order_text"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/textview_order_summary_text"
        android:padding="16dp"/>
    
    <ImageView
        android:id="@+id/ivBeer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/koz_10"
        android:scaleType="centerInside"/>

</LinearLayout>